# Use Entra ID. Do not put passwords, tokens, or API keys in this file.
# azd up writes a private .azure/demo-config.json from deployment outputs.
AZURE_LOCATION=southcentralus
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_ONLINE_DEPLOYMENT=online
AZURE_OPENAI_BATCH_DEPLOYMENT=batch
AZURE_STORAGE_ACCOUNT=
LLM_AUTH_MODE=cli
# Configure a specific approved public client CIDR in the private azd environment.
ALLOWED_CLIENT_PREFIX=
